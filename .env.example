# Server
PORT=5000
NODE_ENV=development

# MongoDB (use the SAME database as the client so both apps share one cluster)
MONGODB_URI=
DB_NAME=booknook

# The Next.js client (CORS + the address BetterAuth signs tokens for)
CLIENT_URL=http://localhost:3000

# Optional: more allowed origins (comma separated), e.g. a Vercel preview URL
EXTRA_ORIGINS=

# Optional overrides (defaults are derived from CLIENT_URL):
# JWKS_URL=http://localhost:3000/api/auth/jwks
# JWT_ISSUER=http://localhost:3000
# JWT_AUDIENCE=http://localhost:3000
